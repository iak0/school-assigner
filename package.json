    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
